{
    "name": "wilkques/log",
    "description": "PHP Log",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Wilkques\\Log\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "require": {
        "php": ">=5.3",
        "wilkques/container": ">=5.0.0",
        "wilkques/filesystem": "^1.0.0 || ^2.0.0",
        "wilkques/php-helper": "^6.1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Wilkques\\Log\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    }
}